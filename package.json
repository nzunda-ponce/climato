{
  "name": "climato",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:manual": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "node --import tsx scripts/database.ts setup",
    "db:migrate": "node --import tsx scripts/database.ts migrate",
    "db:status": "node --import tsx scripts/database.ts status",
    "db:backup": "node --import tsx scripts/database.ts backup",
    "db:restore": "node --import tsx scripts/database.ts restore"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0",
    "@next/env": "15.5.28"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.9.10",
    "prisma": "^6.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
