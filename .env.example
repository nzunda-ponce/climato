# PostgreSQL administrado: Neon, plan Free. Usar la URL con pool y SSL.
# Configurar con npm run db:setup. No subir credenciales a Git.
DATABASE_URL=
# Sin conexión se conserva una base local; no equivale a nube configurada.
# Caché descartable comprimida (MB). Los históricos y equipos no se eliminan.
CLIMATO_CACHE_MAX_MB=128
WEATHER_API_KEY=

# Windy Map Forecast: clave del mapa con licencia de producción.
# El SDK de Windy la usa en el navegador; limitar los dominios en Windy.
WINDY_MAP_API_KEY=

# local (default): instalación existente con procesos de fondo.
# web: informe de consulta, sin descargas ni escrituras. Vercel usa web por defecto.
# worker: procesos independientes data:bootstrap, data:refresh y data:publish.
CLIMATO_ROLE=local
# Opcional: limita una ejecución del proceso de datos, guardando cada lote.
CLIMATO_JOB_MAX_MINUTES=30
